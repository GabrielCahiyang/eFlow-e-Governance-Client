# Index only the combined application's source, migrations, and checks.
# Graphify also respects .gitignore; code-only mode skips semantic documents.
/*
!/src/
!/server/
!/supabase/
!/scripts/
!/tests/
!/package.json
!/vite.config.ts
!/vitest.config.ts
!/playwright.config.ts
!/tsconfig.json
!/tsconfig.node.json

# Dependencies, generated output, and local environments, wherever nested.
node_modules/
.venv/
venv/
.graphify-venv/
__pycache__/
.pytest_cache/
.cache/
dist/
build/
coverage/
htmlcov/
playwright-report/
test-results/
graphify-out/
.git/
.vs/
.vscode/
.idea/
.agents/
.codex/
.codex-tmp/
.commandcode/
.temp/
tmp/
temp/
logs/
backups/
models/

# Secrets and exported records are never navigation input.
.env
.env.*
*.pem
*.key
*dump*.json
*dump*.sql
*backup*.json
*backup*.sql
*snapshot*.json
*.generated.*
*.map
*.log
/tests/sql/phase1-deployed-schema.json

