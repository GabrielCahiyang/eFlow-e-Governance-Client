# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# AI clients use the Cloudflare endpoint published in Supabase by default.
# Opt in to the local Vite proxy only for same-machine development:
# VITE_AI_CONNECTION_MODE=local
# VITE_CONTROL_PANEL_BASE=/api

# Private Python services only. Never prefix this value with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SERVER_ONLY_KEY

# Gateway/runtime configuration
EFLOW_ALLOWED_ORIGINS=https://YOUR_EFLOW_FRONTEND.example
EFLOW_INTERNAL_AI_BASE_URL=http://127.0.0.1:8321/controlpanelEflow/api
EFLOW_AI_TIMEOUT_SECONDS=7200

# Optional Super Admin Backup & Export support. This direct Postgres URL stays
# on the Python gateway and must never use a VITE_ prefix.
EFLOW_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
EFLOW_PG_DUMP_PATH=pg_dump
EFLOW_BACKUP_RETENTION_HOURS=24

# Phase 2 server-only email / invitations. Verified domain required in production.
RESEND_API_KEY=
EFLOW_EMAIL_FROM=eFlow <notifications@YOUR_VERIFIED_DOMAIN>
EFLOW_EMAIL_REPLY_TO=
EFLOW_APP_URL=https://YOUR_EFLOW_FRONTEND.example
EFLOW_INVITE_TOKEN_TTL_HOURS=168
# Restrict the Resend trial sender to your verified test recipient during rehearsal.
EFLOW_EMAIL_TEST_RECIPIENT=
EFLOW_PDS_WORKER_ENABLED=true
# Optional server-only alias, preferred over SUPABASE_SERVICE_ROLE_KEY when set.
SUPABASE_SECRET_KEY=
# Public gateway origin for invitation acceptance before login (never an API key).
VITE_EFLOW_GATEWAY_URL=https://YOUR_GATEWAY.example/controlpanelEflow/api

# Optional isolated Phase 1 restore/rehearsal tooling only. These are not read
# by the application or gateway. Keep real values in ignored local .env files.
# Use the rehearsal project's Session pooler URI and server-only API key;
# never reuse the live database URL or give either variable a VITE_ prefix.
EFLOW_REHEARSAL_DATABASE_URL=
EFLOW_REHEARSAL_SERVICE_ROLE_KEY=
